source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

# shellcheck disable=SC1091
_functions_file="${startdir:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}/../common/functions.sh"
. "$_functions_file"

prepare() {
  arch_normalize_source_tree
}

check() {
  arch_check_branding_payload
}

package() {
  arch_package_branding_payload
}
